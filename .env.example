# Copy to .env, fill in the keys you have, then load it into your shell before running (for example: set -a; . ./.env; set +a).
# A system whose key is missing is skipped. Google News needs no key.
NC_KEY=            # NewsCatcher News API: platform.newscatcherapi.com
EXA_KEY=           # Exa: dashboard.exa.ai
PARALLEL_KEY=      # Parallel: platform.parallel.ai
FIRECRAWL_KEY=     # Firecrawl: firecrawl.dev
OPENROUTER_API_KEY=  # the judge (Claude Opus 5.5 via OpenRouter): openrouter.ai
